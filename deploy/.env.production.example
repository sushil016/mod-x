# Public hostname. Create DNS A records for this name before starting the stack.
DOMAIN=modme.example.com
CLIENT_URL=https://modme.example.com
GOOGLE_CALLBACK_URL=https://modme.example.com/auth/google/callback

NODE_ENV=production
PORT=8080

# Required application secrets. Generate with: openssl rand -base64 48
JWT_SECRET=
COOKIE_SECRET=

# Managed PostgreSQL connection string. Do not run production Postgres on this VM.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Google Cloud Vision credentials. Use one of the two JSON options in Docker.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS_JSON_BASE64=
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# NVIDIA gray-zone reasoning
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_MAX_TOKENS=16384

# Moderation thresholds
THRESHOLD_BLOCK_ADULT=0.75
THRESHOLD_BLOCK_VIOLENCE=0.75
THRESHOLD_BLOCK_RACY=0.95
THRESHOLD_REVIEW_ADULT=0.50
THRESHOLD_REVIEW_VIOLENCE=0.50
THRESHOLD_REVIEW_RACY=0.75

# Frame sampling
GIF_FRAME_COUNT=6
VIDEO_FRAME_INTERVAL_SECONDS=2
VIDEO_MAX_FRAMES=30

# This is overridden to the internal Redis service by compose.yml.
REDIS_PASSWORD=
